// Prisma schema — EcoFlow + Tuya energy management

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DeviceType {
  TUYA_METER
  TUYA_SWITCH
  ECOFLOW_BATTERY
  SHELLY_METER
  APSYSTEMS_INVERTER  // micro-onduleur APSystems DS3 (lu via passerelle Zigbee custom)
}

enum DeviceRole {
  PRODUCTION_METER
  CONSUMPTION_METER
  GRID_METER          // compteur bidirectionnel (signé : + import, - export)
  BATTERY_AC_SWITCH
  BATTERY
  POWERSTREAM         // micro-onduleur EcoFlow PowerStream (injection grid-tied)
  SOLAR_INVERTER      // micro-onduleur DC->AC en amont de la production (APSystems DS3 et co.)
  APPLIANCE           // prise / capteur d'un appareil non structurel (jacuzzi, voiture, etc.)
}

enum HealthAlertKind {
  INVERTER_SILENT     // pas de trame depuis > seuil
  PEER_IMBALANCE      // déséquilibre entre deux panneaux jumeaux (même MPPT/onduleur)
  OVER_TEMPERATURE    // T° onduleur au-dessus de la limite
  GRID_FREQ_OUT       // fréquence AC hors plage 49.5-50.5 Hz
  WEAK_SIGNAL         // RSSI Zigbee dégradé
  PANEL_LOW_DC        // tension DC anormalement basse (diode bypass / ombrage chronique)
}

enum HealthAlertSeverity {
  INFO
  WARN
  CRITICAL
}

enum RuleActionStatus {
  SUCCESS
  FAILED
  SKIPPED
}

enum TariffPeriod {
  OFF_PEAK
  PEAK
  SHOULDER
}

enum ControlMode {
  MANUAL
  RULES
  FOLLOW_LOAD // discharge_W asservi à la consommation maison
  OFF
}

model Device {
  id           String       @id @default(cuid())
  type         DeviceType
  role         DeviceRole
  externalId   String       @unique
  name         String
  vendorMeta   Json?
  capabilities Json?
  enabled      Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  readings        Reading[]
  hourlyReadings  ReadingHourly[]
  ruleExecutions  RuleExecution[]
  panelReadings   SolarPanelReading[]
  healthAlerts    HealthAlert[]
  loadProfilesMeasured LoadProfile[] @relation("LoadProfileMeasuredDevice")
}

// Lecture instantanée par panneau solaire (par MPPT d'un micro-onduleur).
// Pour un APSystems DS3 (DUO), il y a 2 panneaux par onduleur (panelIndex 0/1).
model SolarPanelReading {
  id          BigInt   @id @default(autoincrement())
  deviceId    String   // référence à l'onduleur (Device.role = SOLAR_INVERTER)
  panelIndex  Int      // 0..N — entrée MPPT
  ts          DateTime @db.Timestamptz(3)
  dcV         Float?   // tension DC entrée panneau (V)
  dcA         Float?   // courant DC entrée panneau (A)
  pW          Float?   // puissance instantanée (W)
  energyWh    Float?   // énergie cumulée depuis le démarrage de l'onduleur (Wh)
  acV         Float?   // tension AC réseau côté onduleur
  acHz        Float?   // fréquence AC
  tempC       Float?   // température interne onduleur
  signalDb    Float?   // RSSI Zigbee
  raw         Json?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, panelIndex, ts(sort: Desc)])
  @@index([ts(sort: Desc)])
}

// Alerte de santé matérielle (panneau / onduleur). Persistée pour l'affichage
// historique ; les alertes en cours sont celles avec resolvedAt = null.
model HealthAlert {
  id         BigInt              @id @default(autoincrement())
  deviceId   String
  panelIndex Int?                // null si l'alerte concerne tout l'onduleur
  kind       HealthAlertKind
  severity   HealthAlertSeverity @default(WARN)
  message    String
  detail     Json?
  startedAt  DateTime            @default(now()) @db.Timestamptz(3)
  resolvedAt DateTime?           @db.Timestamptz(3)
  acknowledgedAt DateTime?       @db.Timestamptz(3)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, resolvedAt])
  @@index([startedAt(sort: Desc)])
}

model Reading {
  id        BigInt   @id @default(autoincrement())
  deviceId  String
  ts        DateTime @db.Timestamptz(3)
  powerW    Float?
  energyWh  Float?
  soc       Float?
  switchOn  Boolean?
  raw       Json?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, ts(sort: Desc)])
  @@index([ts(sort: Desc)])
}

model ReadingHourly {
  id         BigInt   @id @default(autoincrement())
  deviceId   String
  hourTs     DateTime @db.Timestamptz(3)
  avgPowerW  Float?
  prodWh     Float?
  consoWh    Float?
  minSoc     Float?
  maxSoc     Float?
  samples    Int      @default(0)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, hourTs])
  @@index([hourTs(sort: Desc)])
}

model AutomationRule {
  id              String   @id @default(cuid())
  name            String
  enabled         Boolean  @default(true)
  priority        Int      @default(100)
  conditionExpr   Json
  actions         Json
  minHoldSeconds  Int      @default(60)
  hysteresis      Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  executions RuleExecution[]
}

model RuleExecution {
  id         BigInt           @id @default(autoincrement())
  ruleId     String
  ts         DateTime         @default(now()) @db.Timestamptz(3)
  triggered  Boolean
  status     RuleActionStatus
  context    Json?
  result     Json?
  error      String?
  deviceId   String?

  rule   AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  device Device?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([ruleId, ts(sort: Desc)])
  @@index([ts(sort: Desc)])
}

model SystemConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Profil d'appareil consommateur récurrent (piscine, PAC, voiture, jacuzzi…).
// L'utilisateur saisit la puissance moyenne attendue ; le système détecte
// automatiquement les fenêtres horaires d'activation et les enregistre.
model LoadProfile {
  id              String   @id @default(cuid())
  name            String
  expectedPowerW  Int      // puissance moyenne typique configurée
  toleranceW      Int      @default(150)
  minDurationMin  Int      @default(15)
  // Plage horaire d'éligibilité (heures locales 0-23). Si null/null,
  // le profil est éligible 24/24. Si endHour <= startHour, la fenêtre
  // traverse minuit (ex. 22h -> 6h).
  activeStartHour Int?
  activeEndHour   Int?
  // Lien optionnel vers une prise mesurée (Tuya/Shelly). Si renseigné,
  // currentlyOn = mesure directe (switchOn ou powerW > onThresholdW)
  // au lieu de l'heuristique combinatoire sur le delta de conso.
  measuredDeviceId String?
  measuredOnThresholdW Int?
  enabled         Boolean  @default(true)
  detectedSchedule Json?   // {byDow: [...], confidence}
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  events LoadEvent[]
  measuredDevice Device? @relation("LoadProfileMeasuredDevice", fields: [measuredDeviceId], references: [id], onDelete: SetNull)
}

// Cycle d'activation détecté (ou consommation orpheline non matchée).
model LoadEvent {
  id          BigInt   @id @default(autoincrement())
  profileId   String?
  startTs     DateTime @db.Timestamptz(3)
  endTs       DateTime @db.Timestamptz(3)
  avgPowerW   Float
  energyWh    Float?
  durationMin Int
  matched     Boolean  @default(false)
  notes       String?

  profile LoadProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([startTs(sort: Desc)])
  @@index([profileId, startTs(sort: Desc)])
}

// Trace de chaque exécution de l'agent LLM (Ollama).
model AgentRun {
  id           BigInt   @id @default(autoincrement())
  ts           DateTime @default(now()) @db.Timestamptz(3)
  trigger      String   // "schedule" | "manual"
  model        String?
  context      Json
  prompt       String   @db.Text
  response     String?  @db.Text
  proposal     Json?
  applied      Boolean  @default(false)
  appliedJson  Json?
  error        String?
  durationMs   Int?

  @@index([ts(sort: Desc)])
}

// Fenêtres tarifaires (heures creuses / pleines / pointe).
// Exprimées en heure locale (Europe/Paris). Les jours sont un bitmap
// (1=Lun ... 7=Dim) ou null pour tous les jours.
model TariffWindow {
  id          String       @id @default(cuid())
  name        String
  period      TariffPeriod
  startMinute Int          // minutes depuis 00:00, 0..1439
  endMinute   Int          // peut être > startMinute (chevauchement minuit géré côté code)
  daysOfWeek  Int[]        // [1..7], vide = tous les jours
  pricePerKwh Float?
  enabled     Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([enabled, period])
}

// État courant du contrôleur — singleton (key = "default").
model ControlState {
  key                String      @id @default("default")
  mode               ControlMode @default(RULES)
  // Cible d'injection lorsque mode = FOLLOW_LOAD : marge à appliquer
  // sous la consommation maison pour éviter l'export réseau (W).
  followLoadOffsetW  Int         @default(50)
  // Bornes d'injection appliquées en mode FOLLOW_LOAD.
  followLoadMinW     Int         @default(0)
  followLoadMaxW     Int         @default(800)
  // Puissance de charge AC max (W) appliquée à la batterie via setChargeWatts.
  chargeMaxW         Int         @default(800)
  // Borne basse hardware EcoFlow : sous ce seuil, on ne charge pas (prise OFF).
  chargeMinW         Int         @default(400)
  // Marge retirée du surplus pour rester sous l'export zéro (W).
  chargeOffsetW      Int         @default(100)
  // Tolérance avant de couper la prise quand surplus < chargeMinW pendant
  // une charge (minutes). Permet d'absorber un consommateur ponctuel.
  chargeDeficitTimeoutMin Int    @default(10)
  // Verrou de redémarrage : durée minimale (minutes) pendant laquelle on
  // refuse de rallumer la prise après l'avoir coupée.
  chargeOffToOnLockMin    Int    @default(5)
  // Décharge programmée selon la couleur EDF Tempo du jour : pendant la
  // fenêtre, on coupe la prise Tuya et on laisse la batterie alimenter
  // la maison. tempoColor (BLUE/WHITE/RED/UNKNOWN) est mis à jour par le
  // poller, les heures sont les paramètres utilisateur.
  tempoEnabled            Boolean @default(true)
  tempoRedDischargeHour   Int     @default(17)
  tempoOtherDischargeHour Int     @default(22)
  tempoDischargeEndHour   Int     @default(6)
  tempoDischargeTargetW   Int     @default(400)
  // Temps (en minutes) avant la fin de la fenetre tempo pendant lequel
  // on rallume la prise AC IN pour reveiller la batterie de sa veille
  // profonde, afin qu'elle soit prete a charger des l'aube solaire.
  tempoWakeupBeforeMin    Int     @default(15)
  tempoColor              String  @default("UNKNOWN")
  tempoColorTomorrow      String  @default("UNKNOWN")
  tempoLastFetchAt        DateTime?
  // Baseline conso (W) utilisee pour la detection live d'appareils.
  // Si null, calcul automatique (mediane nocturne 2h-5h sur 7j).
  loadsBaselineW          Int?
  // PowerStream EcoFlow : SN + dernière puissance d'injection appliquée.
  // permanentWatts est la consigne 'mode manuel' (0 = mode AUTO).
  powerstreamSn           String?
  powerstreamPermanentW   Int     @default(0)
  // 0 = privilegier l'alimentation (decharge maison),
  // 1 = privilegier le stockage (charge batterie).
  powerstreamPriority     Int     @default(0)
  // SoC minimum auquel on s'autorise à décharger.
  minDischargeSoc    Int         @default(20)
  // SoC maximum visé en charge.
  maxChargeSoc       Int         @default(95)
  updatedAt          DateTime    @updatedAt
}
