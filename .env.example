# --- PostgreSQL ---
POSTGRES_USER=ecoflow
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ecoflow
DATABASE_URL=postgresql://ecoflow:changeme@postgres:5432/ecoflow?schema=public

# --- EcoFlow Developer API ---
# https://developer.ecoflow.com
ECOFLOW_ACCESS_KEY=
ECOFLOW_SECRET_KEY=
ECOFLOW_API_BASE=https://api-e.ecoflow.com
ECOFLOW_MQTT_BROKER=mqtt-e.ecoflow.com
ECOFLOW_MQTT_PORT=8883

# --- Tuya Cloud API ---
# https://iot.tuya.com
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=
# eu | us | cn | in
TUYA_REGION=eu
TUYA_API_BASE=https://openapi.tuyaeu.com

# --- Worker ---
POLL_INTERVAL_SECONDS=30
RAW_RETENTION_DAYS=30
HOURLY_RETENTION_DAYS=365

# --- Agent LLM (Ollama) ---
OLLAMA_BASE_URL=http://192.168.0.71:11434
OLLAMA_MODEL=gemma4:31b
AGENT_INTERVAL_MINUTES=60
AGENT_ENABLED=true
# Sécurité batterie : si SoC ≤ ce seuil, on force la prise AC ON pour permettre
# le réveil/la recharge.
BATTERY_CRITICAL_SOC=5

# --- Météo (Open-Meteo, sans clé) ---
HOME_LAT=48.9436
HOME_LON=1.9930
HOME_TZ=Europe/Paris

# --- Jacuzzi Intex (module Wi-Fi local) ---
# Modeles compatibles : SB-HWF20, SB-HSWF20, SC-WF20, SC-WF20-1
# (panneau de commande SANS "TY" dans le code grave).
# IP locale du module Wi-Fi a figer en DHCP reserve sur le routeur.
INTEX_SPA_HOST=
INTEX_SPA_PORT=8990
INTEX_SPA_ENABLED=false

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_APP_NAME="EcoFlow Villennes"
